{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to all app windows (overlay, settings, onboarding) — commands + Rust→JS events.",
  "windows": ["overlay", "main", "onboarding"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "global-shortcut:default"
  ]
}
