{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "murmur",
  "version": "0.0.0",
  "identifier": "dev.lgr.murmur",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "murmur",
        "url": "index.html",
        "width": 320,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "acceptFirstMouse": false,
        "center": true
      },
      {
        "label": "main",
        "title": "Murmur",
        "url": "settings.html",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": true,
      "tooltip": "murmur"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "murmur dev"
    }
  }
}
